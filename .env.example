# =============================================================================
# urdu-voice-agent — environment template
# =============================================================================
# Copy to `.env` and fill in. NEVER commit a real `.env` (see .gitignore).
# Gemini reasoning + embeddings authenticate via Vertex AI ADC (the attached
# service account), so no Gemini API key is needed on the agent side. For local
# dev run `gcloud auth application-default login` once.
# -----------------------------------------------------------------------------

# --- LiveKit (RTC bridge) ----------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Agent identity / routing ------------------------------------------------
# AGENT_NAME MUST equal the LiveKit dispatch rule's --agent-name.
AGENT_NAME=voice-agent
# The DID this worker primarily answers on (used by the monitor sidecar default).
AGENT_PHONE_NUMBER=
AGENT_ENV=dev
DEPLOY_MODE=local
# Selects the configs/environments.yaml block (prod | dev). Empty = use the
# values inside each tenant YAML as-is.
CONFIG_ENV=
# Fail closed on unknown called-numbers (recommended true in prod).
MULTI_TENANT_STRICT_ROUTING=true
SINGLE_TENANT_MODE=false
# Prewarmed idle worker processes + init timeout.
NAVAI_NUM_IDLE_PROCESSES=5
NAVAI_INIT_PROCESS_TIMEOUT=30
# Set to 0 to skip per-tenant KB prewarm on boot.
NAVAI_PREWARM_KB=1
LOG_LEVEL=INFO

# --- Platform API (control plane link) ---------------------------------------
PLATFORM_API_URL=http://localhost:3000
# Default / fallback API key for non-tenant-scoped requests.
INTERNAL_API_KEY=
AGENT_API_KEY=
# Optional bearer JWT for routes documented as bearerAuth.
PLATFORM_API_JWT=
# Optional legacy compatibility fallback (disabled by default). When true, a
# tenant whose {SLUG_UPPER}_AGENT_API_KEY is unset falls back to the keys above.
ENABLE_LEGACY_INTERNAL_API_KEY_FALLBACK=false
# Per-tenant agent API keys are resolved by slug, data-driven:
#   {SLUG_UPPER}_AGENT_API_KEY   (slug uppercased, non-alphanumeric -> '_')
# e.g. for slug "example-tenant":
EXAMPLE_TENANT_AGENT_API_KEY=

# --- LLM ---------------------------------------------------------------------
# Gemini (default, llm.provider: gemini): Vertex AI ADC, no key. Set the GCP
# project/location used by the agent for Vertex (reasoning + embeddings).
# Empty => resolved from ADC.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
# Gemini via Google AI Studio API key (llm.provider: gemini_api). Use this when
# you don't have GCP / Vertex ADC available locally.
GOOGLE_API_KEY=
# OpenAI-compatible LLM (voice.llm.provider: openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Self-hosted vLLM (voice.llm.provider: custom)
CUSTOM_LLM_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=

# --- STT (speech-to-text) ----------------------------------------------------
# >>> URDU integration seam <<< — voice.stt_provider: urdu_stt is wired to
# Speechmatics' real-time streaming API (livekit-plugins-speechmatics).
# Get a project API key at https://portal.speechmatics.com/.
SPEECHMATICS_API_KEY=
# Optional override (defaults to wss://eu2.rt.speechmatics.com/v2):
URDU_STT_URL=
# Managed default needs no env (LiveKit inference gateway -> deepgram).
# Yandex SpeechKit (voice.stt_provider: yandex)
YANDEX_API_KEY=
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
# HTTP / WS GPU STT servers (voice.stt_provider: custom | navai | navai_ws)
CUSTOM_STT_URL=
# Set to 1/true to reroute tenants on 'custom' STT to Yandex when the GPU host is down.
DISABLE_CUSTOM_STT=
NAVAI_STT_URL=
NAVAI_WS_STT_URL=
# Per-utterance ceiling (seconds) for the streaming WS STT.
# NAVAI_WS_STT_MAX_SECONDS=60

# --- TTS (text-to-speech) ----------------------------------------------------
# >>> URDU integration seam <<< — voice.tts_provider: urdu_tts is wired to
# Azure Cognitive Services neural voices (livekit-plugins-azure). Use one of
# the Urdu neural voices (e.g. ur-PK-UzmaNeural, ur-PK-AsadNeural).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Either set AZURE_SPEECH_REGION above or AZURE_SPEECH_ENDPOINT below.
AZURE_SPEECH_ENDPOINT=
# Default voice when voice.tts_voice_id / voice.voices is unset.
URDU_VOICE_ID=ur-PK-UzmaNeural
# Optional override (overrides AZURE_SPEECH_ENDPOINT for the urdu_tts provider).
URDU_TTS_URL=
# Yandex SpeechKit (voice.tts_provider: yandex)
YANDEX_VOICE_ID=
# HTTP / WS GPU TTS servers (voice.tts_provider: custom | navai | navai_ws)
CUSTOM_TTS_URL=
CUSTOM_VOICE_ID=
NAVAI_TTS_URL=
NAVAI_VOICE_ID=
NAVAI_WS_TTS_URL=
NAVAI_WS_VOICE_ID=
# NAVAI_WS_TTS_MODE=grpc
# NAVAI_WS_TTS_MAX_SECONDS=60
# Shared gateway key for the navai_ws STT/TTS providers (X-API-Key header).
NAVAI_API_KEY=

# --- RAG / Qdrant ------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# Override the collection used by eval/check_kb.py (defaults to example_tenant_faq).
KB_COLLECTION=

# --- Observability -----------------------------------------------------------
METRICS_PORT=9090
HEALTH_PORT=8082
NETWORK_OBS_ENABLED=1
NETWORK_OBS_MAX_EVENTS=500
NETWORK_OBS_PERSIST_PATH=/tmp/voice-agent-network-topology.jsonl
NETWORK_GEO_ENABLED=0
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=dev

# --- Agent monitor sidecar (optional) ----------------------------------------
# Sends a periodic LiveKit text probe; notifies a Telegram channel on failure.
MONITOR_INTERVAL_SECONDS=3600
MONITOR_INITIAL_DELAY_SECONDS=30
MONITOR_NOTIFY_MODE=failures_only
MONITOR_HEALTH_URL=http://agent:8082/health
MONITOR_CALLED_PHONE=
MONITOR_PROBE_TEXT=hello
MONITOR_TELEGRAM_BOT_TOKEN=
MONITOR_TELEGRAM_CHAT_ID=
MONITOR_TELEGRAM_THREAD_ID=

# --- WhatsApp Cloud API (scripts/whatsapp_webhook.py) -----------------------
# Bridge the WhatsApp Connector (LiveKit's `connector.accept_whatsapp_call`) to
# inbound WhatsApp voice calls. See docs/WHATSAPP_SETUP.md for the full Meta
# Developer App + Business Phone Number walkthrough.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=23.0
WHATSAPP_DESTINATION_COUNTRY=PK
WHATSAPP_WEBHOOK_PORT=8090
# Full-pipeline Voice Agent API (STT + LLM + TTS)
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_TENANT_SLUG=relaydesk
ASSEMBLYAI_ROOM_NAME=relaydesk-demo
DATABASE_URL=postgresql://relaydesk:change-me@localhost:5432/relaydesk
# Full-pipeline Voice Agent API (STT + LLM + TTS)
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_TENANT_SLUG=relaydesk
ASSEMBLYAI_ROOM_NAME=relaydesk-demo
